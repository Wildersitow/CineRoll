DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=genera-una-clave-larga-y-aleatoria

DB_NAME=cineroll
DB_USER=cineroll
DB_PASSWORD=cambia-esto
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0

CACHE_URL=redis://redis:6379/1

# Hay un proxy (Caddy) delante de Django: necesario para ver la IP real del visitante.
NUM_PROXIES=1

# Dominio de la API (ver Parte B) y orígenes permitidos
DOMINIO=cineroll-api.duckdns.org
ALLOWED_HOSTS=cineroll-api.duckdns.org
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://cineroll-api.duckdns.org
USAR_HTTPS=True

CINELAND_API_KEY=
CINELAND_EMAIL=
CINELAND_PASSWORD=