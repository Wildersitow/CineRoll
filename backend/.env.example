SECRET_KEY=cambia-esto
USE_SQLITE=False
DB_NAME=cineroll
DB_USER=cineroll
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# Solo en el servidor de producción (en local se dejan comentadas):
# DJANGO_SETTINGS_MODULE=config.settings.production
# ALLOWED_HOSTS=api.cineroll.com
# CORS_ALLOWED_ORIGINS=https://cineroll.com
# CSRF_TRUSTED_ORIGINS=https://api.cineroll.com
# USAR_HTTPS=True

REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0

# Credenciales del cliente web de Cineland; no versionar sus valores reales.
CINELAND_API_KEY=
CINELAND_EMAIL=
CINELAND_PASSWORD=

# Cines que se scrapean automáticamente (formato cine:ciudad, separados por comas).
# Si no se define, se usan los tres de Valledupar.
# CARTELERA_ACTIVA=cinepolis:valledupar,royal_films:valledupar,cineland:valledupar

# Solo pruebas/CI: ejecuta las tareas de Celery en el mismo proceso, sin Redis.
# CELERY_TASK_ALWAYS_EAGER=False